# Copy this file to api/.env and adjust. api/.env is committed to git, so keep real passwords out of it
# (use Windows authentication, or keep production secrets in server environment variables).

# ---- Database --------------------------------------------------------------------------------------
# SQL Server, Windows authentication (named instance SQL_LOCAL on this machine):
DATABASE_URL=mssql+pyodbc://@localhost\SQL_LOCAL/carbon_latest?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# SQL Server with a SQL login instead (URL-encode special characters in the password, e.g. @ -> %40):
# DATABASE_URL=mssql+pyodbc://carbon_app:YourPassword@localhost\SQL_LOCAL/carbon_latest?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# The schema is created and upgraded by the migrations (alembic upgrade head), not at start-up.
AUTO_CREATE_SCHEMA=false

# ---- Application -----------------------------------------------------------------------------------
ENVIRONMENT=development
# Use a long random value outside development: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
