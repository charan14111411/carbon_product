# Template for api/.env (copy it there). Live services are commented out here: the copy starts on the simulation.
# This file is committed to git: keep real passwords out of it (Windows authentication needs none).
# Lines starting with # are notes or built-in defaults; only uncomment a default to change its value.
# After editing: restart the API (Ctrl+C, then ..\.venv\Scripts\python -m uvicorn app.main:app --port 8000).

# ==== Database ===========================================================================================
# SQL Server, Windows authentication, named instance SQL_LOCAL, database carbon_latest.
DATABASE_URL=mssql+pyodbc://@localhost\SQL_LOCAL/carbon_latest?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# With a SQL login instead (URL-encode special characters in the password, e.g. @ -> %40):
# DATABASE_URL=mssql+pyodbc://carbon_app:YourPassword@localhost\SQL_LOCAL/carbon_latest?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# The tables come from the migrations (..\.venv\Scripts\python -m alembic upgrade head), never at start-up.
AUTO_CREATE_SCHEMA=false

# ==== Application ========================================================================================
# development: demo OTP 123456 works and two-step sign-in is optional. production: both are enforced.
ENVIRONMENT=development
# Outside development use a long random value: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# ==== Varsapradaya (FarmFuture) — uncomment to use live ====================================================================
# Member lookup by phone number + one-click farm import (read at start-up: restart the API after a change).
# VC_MEMBER_DIRECTORY=farmfuture
# A farm's SoilSync / MicroClime: read every VARSAPRADAYA_POLL_MINUTES and kept, so the farm's own devices
# supply its daily data (tier 1, MEASURED). Farms without devices fall back to a Varsapradaya device within
# 25 km, then the public sources below.
# VC_DEVICE_PROVIDER=farmfuture
# Built-in defaults (no key needed: the token comes from the farmer's phone number and stays in memory only):
# VARSAPRADAYA_POLL_MINUTES=60          # 0 = no automatic reading
# FARMFUTURE_BASE_URL=https://api.farmfuture.io/api
# FARMFUTURE_TIMEOUT_S=30
# FARMFUTURE_TOKEN_TTL_S=900
# FARMFUTURE_VERIFY_TLS=true
# FARMFUTURE_COUNTRY_CODE=+91           # added to numbers typed without a country code
# Check the connection (read-only) with your own number: ..\.venv\Scripts\python -m scripts.farmfuture_check +91XXXXXXXXXX

# ==== Public data sources — uncomment to use live (no accounts, no keys) ===================================================
# Only coordinates, dates and public scene ids are sent — never farmer or user data. If a source is down,
# the app records "source unavailable" for those days and carries on.
# Weather for days without a device (rain, air temperature, humidity, solar, wind) — NASA POWER, MODELLED.
# VC_WEATHER_PROVIDER=nasa_power
# Soil-map suggestions (texture, WRB group) and soil pH — ISRIC SoilGrids 250 m, MODELLED (10–40 s per new
# location the first time, then cached).
# VC_SOIL_PROVIDER=soilgrids
# Sentinel-2 (NDVI, NDMI, NDWI) and Landsat (land surface temperature) — Microsoft Planetary Computer.
# VC_SATELLITE_PROVIDER=planetary_computer
# Elevation, slope, aspect and slope class — Copernicus DEM 30 m via Planetary Computer.
# VC_TERRAIN_PROVIDER=copernicus_dem
# Built-in defaults:
# NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/daily/point
# SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
# STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# PC_DATA_API_URL=https://planetarycomputer.microsoft.com/api/data/v1
# HTTP_TIMEOUT_S=60
# HTTP_RETRIES=2

# ==== Still simulated (no real provider exists yet) =======================================================
# SMS / WhatsApp (VC_MESSAGING_PROVIDER) and UPI payouts (VC_PAYOUT_PROVIDER) need an account with a provider.
# Leave them unset until one is connected.

# To go back to the offline simulation for any service, put # in front of its VC_… line.
# The demo seed (scripts.seed_demo) and the tests always use the simulation, whatever this file says.
